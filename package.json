{
	"devDependencies": {
		"sass": "^1.97.1"
	},
	"scripts": {
		"build-css": "npx sass --no-source-map \"src/main/webapp/libs/qpx/scss/qp-framework.scss\" \"src/main/webapp/libs/qpx/themes/jquery.qpx.default.css\"",
		"build-light": "npx sass --no-source-map \"src/main/webapp/libs/qpx/scss/theme/light/all.scss\" \"src/main/webapp/libs/qpx/themes/jquery.qpx.light.css\"",

		"watch-css": "npx sass --watch --no-source-map \"src/main/webapp/libs/qpx/scss/qp-framework.scss\" \"src/main/webapp/libs/qpx/themes/jquery.qpx.default.css\"",
		"test-css": "npx sass \"src/main/webapp/libs/qpx/scss/qp-framework.scss\""
	}
}